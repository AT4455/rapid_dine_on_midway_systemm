# ─────────────────────────────────────────────────────────────
# Rapid Dine — environment template (copy to .env)
# Never commit real secrets. This file contains safe placeholders.
# ─────────────────────────────────────────────────────────────

# MySQL connection string.
# Local MySQL helper (scripts/mysql-local.ps1) uses port 3307.
DATABASE_URL="mysql://root@127.0.0.1:3307/rapiddine"

# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Public app URL (used by Socket.IO client fallback + metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo mode: enables one-click demo logins and the labelled journey simulator.
# Set to false for any real deployment.
DEMO_MODE="true"

# ── Routing provider (OSRM compatible) ───────────────────────
# Default uses the public OSRM demo server (rate-limited, no SLA).
# Point this at your own OSRM instance for production.
ROUTING_PROVIDER="osrm"
ROUTING_BASE_URL="https://router.project-osrm.org"
ROUTING_API_KEY=""
ROUTING_TIMEOUT_MS="8000"

# ── Geocoding provider (OSM Nominatim compatible) ────────────
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODING_USER_AGENT="RapidDine/1.0 (hackathon demo)"

# ── Map tiles ────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# ── AI assistant (OpenAI-compatible) ─────────────────────────
# Leave LLM_API_KEY empty to use the deterministic rule-based assistant.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS="20000"

# ── Socket.IO ────────────────────────────────────────────────
# The Socket.IO server runs inside the custom Next.js server by default.
# Set SOCKET_PORT only if you split it out (not required for local dev).
SOCKET_PORT=""
SOCKET_CORS_ORIGIN=""

# ── Demo accounts (seed) ─────────────────────────────────────
SEED_DEMO_PASSWORD="Demo@1234"
